      "parameters": {
        "executeOnce": false,
        "command": "=set -e\n\nSRC=\"/root/.n8n-files/soca/{{ $node[\"Trigger\"].json.project }}/metadata\"\nDST=\"/root/.n8n-files/saltbot/{{ $node[\"Trigger\"].json.project }}/metadata-selected\"\n\nrm -rf \"$DST\"\nmkdir -p \"$DST\"\n\n{{ $node[\"Filter repos\"].json.repos_url.map(url => {\n  const clean = url.replace('https://github.com/', '').replace(/\\/$/, '');\n  const [owner, repo] = clean.split('/');\nconst repoFile = repo.replace(/\\./g, '-');\nreturn `find \"$SRC\" -maxdepth 1 -type f -name '${owner}_${repoFile}_*.json' | sort | tail -n 1 | while read f; do cp \"$f\" \"$DST/\"; done`;\n}).join('\\n') }}\n\ncount=$(find \"$DST\" -maxdepth 1 -type f -name '*.json' | wc -l | tr -d ' ')\n\necho \"{\\\"selected_metadata_count\\\":$count,\\\"expected_repos\\\":{{ $node[\"Filter repos\"].json.repos_url.length }},\\\"metadata_dir\\\":\\\"$DST\\\"}\"\n\ntest \"$count\" -eq \"{{ $node[\"Filter repos\"].json.repos_url.length }}\""
      },
