# all Github operations will need this token,
# in doc the scopes that needs
GITHUB_API_TOKEN=your_github_token_here

# jobs consume by rabbimq
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=password123

# by default use this values, resqui & rsfc do too many
# requests so if you are processing a great number of repos
# github will rate limit you
RATE_LIMIT_SOCA_ENABLED=false 
RATE_LIMIT_RSFC_ENABLED=true
RATE_LIMIT_RESQUI_ENABLED=true

# the outputs dir needs to be inside containers dir
OUTPUTS=\path\to\containers\outputs

# port for the software catalog visualization
PORTAL_PORT=port_deployment_nginx

# requi conf you want to use (plugins & checks)
RESQUI_CONF=basic


DASHBOARD_ORG_EMBED_ID=SQO-ORG
DASHBOARD_REPO_EMBED_ID=SQO-REPO
# dashverse token needed for updating dashverse dashboards
DASHVERSE_JWT=token_generated_from_localhost:8000
# domain where is going to be plublished dashverse
SUPERSET_PUBLIC_DOMAIN=http://localhost:8088

# wikidata bot credentials
WIKIBASE_USER=wikibaseuser@wikibasebot
WIKIBASE_PASSWORD=wikibasebotpassword