    {
      "parameters": {
        "jsCode": "const normalize = url =>\n  url.trim().replace(/\\/+$/, '').replace(/\\.git$/i, '').toLowerCase();\n\n// Edita esta lista para excluir repositorios.\nconst excluded = new Set([\n  'https://github.com/oeg-upm/TINTOlib-Crash_Course',\n  'https://github.com/oeg-upm/TINTOlib-Documentation',\n  'https://github.com/oeg-upm/oeg-software-graph',\n].map(normalize));\n\nconst data = $input.first().json;\n\nconst repos = (data.repos_url ?? []).filter(\n  url => !excluded.has(normalize(url))\n);\n\nreturn [{\n  json: {\n    ...data,\n    repos_url: repos,\n    repo_count: repos.length,\n  },\n}];"
      },
